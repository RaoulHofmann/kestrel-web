# Base URL of the Kestrel API. Defaults to the hosted Fly app when unset.
# Leave this EMPTY to route requests through the Nuxt dev proxy (see
# nuxt.config.ts -> nitro.devProxy) and avoid CORS while developing locally.
NUXT_PUBLIC_API_BASE=

# Set when building for GitHub Pages so asset URLs include the repo path.
# NUXT_APP_BASE_URL=/kestrel-web/
